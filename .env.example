# Salin file ini menjadi .env.local lalu isi nilainya.
# Semua nilai ada di dashboard Supabase -> Project Settings -> API Keys.
# Di Vercel, isi variabel yang sama di Project Settings -> Environment Variables.

# Alamat project Supabase
NEXT_PUBLIC_SUPABASE_URL=https://ISI_PROJECT_REF.supabase.co

# Kunci publik (Publishable key "sb_publishable_..." atau anon key lama).
# Aman terlihat di browser karena semua tabel dilindungi RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Kunci rahasia (Secret key "sb_secret_..." atau service_role key lama).
# Dipakai menu "Akun Admin" di panel (tambah/hapus admin, atur ulang sandi)
# dan skrip npm run admin:*. Hanya dibaca di server, tidak pernah dikirim ke browser.
# JANGAN diberi awalan NEXT_PUBLIC_ dan jangan dibagikan / di-commit.
SUPABASE_SECRET_KEY=
